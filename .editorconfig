root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint reads this section. We use the official style as is: no disabled rules, no overrides.
# Run `./gradlew ktlintFormat` to fix most violations.
[*.{kt,kts}]
ktlint_code_style = ktlint_official

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
